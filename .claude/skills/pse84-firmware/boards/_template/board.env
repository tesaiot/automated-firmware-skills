# Board TYPE profile template - copy boards/_template to boards/<id> and fill in.
# Leave unknown values empty (scripts stop with a clear message) and mark guesses "# UNVERIFIED".
# Do not put probe serial / COM port here: discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. my-e84-board
BOARD_NAME=""                           # human name
BOARD_DEFINE=                           # e.g. BOARD_MY_E84_BOARD; also map it in templates/_common/proj_cm33_ns/board/board.h
BOARD_PARTS="ai-kit"                    # hardware groups = the packs this board is made of (<pack>/pack.json "group")
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 e.g. "SW2,SW4"

MTB_TOOLS_VERSION=3.9
PROGTOOLS_VERSION=1.9

BSP_ID=                                 # Project Creator board id, e.g. KIT_PSE84_AI (--list-boards)
BSP_DIR=                                # auto-detected by new_app.sh; copy the value it prints
BSP_VERSION=                            # x.y.z from bsps/<dir>/props.json
BSP_SOURCE=vendor                       # or git:<repo>@<commit>:<subdir> (see reference/project.md)
BSP_BASE_MODUS_SHA256=                  # sha256 of the unmodified base config/design.modus
BSP_OVERLAY_MODUS=                      # empty = use the BSP unchanged
BSP_OVERLAY_MODUS_SHA256=
BSP_OVERLAY_EXTRA=                      # optional "src:dst" pairs, e.g. "design.cyqspi:config/design.cyqspi"

APP_TEMPLATE_REPO=https://github.com/Infineon/mtb-example-psoc-edge-hello-world.git
APP_TEMPLATE_COMMIT=a4a17e27cd7ca35630a6ede798a2adc3390b77b9

EXPECTED_DEVICE=                        # MPN printed by identity_check, e.g. PSE846GPS2DBZC4A
EXPECTED_LIFECYCLE=DEVELOPMENT
OPENOCD_TARGET_CFG=target/infineon/pse84xgxs2.cfg   # EPC2; EPC4 parts need another cfg + keys

CONSOLE_BAUD=115200

POWER_CYCLE_AFTER_FLASH=0
