# Board TYPE profile: TESAIoT PSoC Edge E84 DevKit = AI Kit (SoM) + QWA309 base board.
# Inherits everything from kit-pse84-ai (BSP, clocks, device, console); adds the QWA309 I/O.
# QWA309 I/O is not in the BSP: board/board.c configures it at run time when BOARD_TESAIOT
# is defined (BOARD_HAS_QWA309). HW reference: TESAIoT SDK docs J5.
# Status: AI-Kit part verified 2026-10-03; QWA309 SW4/SW5 see README verification log.

BOARD_EXTENDS=kit-pse84-ai
BOARD_ID=tesaiot
BOARD_NAME="TESAIoT PSE84 DevKit"
BOARD_DEFINE=BOARD_TESAIOT
BOARD_PARTS="ai-kit qwa309"              # AI Kit + QWA309 base board (boards/components.json, board_gate.py)
BTN_LABELS="SW1 (AI Kit user button),SW4 (QWA309 base board),SW5 (QWA309 base board)"   # BTN1..BTN3
# SW4/SW5 (P17.5/P17.7) read 0 permanently while the DVP camera is plugged in (camera RESET/PWDN nets).
