# Board TYPE profile: Infineon PSOC Edge E84 AI Kit (KIT_PSE84_AI), ON-BOARD I/O ONLY.
# Also the parent of `tesaiot` (AI Kit + QWA309 base board), which extends this profile.
# Status: VERIFIED on hardware 2026-10-03 (as the TESAIoT kit's AI Kit: button-led).
# HW reference: TESAIoT SDK docs J4 / "Peripherals at a glance".
# Probe serial / COM port of a physical board: run discover.sh kit-pse84-ai (bench file).

BOARD_ID=kit-pse84-ai
BOARD_NAME="PSOC Edge E84 AI Kit"
BOARD_DEFINE=BOARD_KIT_PSE84_AI
BOARD_PARTS="ai-kit"                     # hardware groups (pack psoc-e84-ai-kit parts.json): NO QWA309 base-board parts - board_gate.py blocks them
BTN_LABELS="SW1 (AI Kit user button)"  # CYBSP_USER_BTN1 = CYBSP_SW1 = P7.0; on our kit SW1=user, SW2=RESET (verified 2026-10-03)

MTB_TOOLS_VERSION=3.9
PROGTOOLS_VERSION=1.9

BSP_ID=KIT_PSE84_AI                     # vendor BSP works as-is
BSP_DIR=TARGET_APP_KIT_PSE84_AI
BSP_VERSION=1.4.0
BSP_SOURCE=vendor
BSP_BASE_MODUS_SHA256=64f9a212b73f59fd7ca71aa3cbc053b112faf4869b3187babb907a54071d8614
BSP_OVERLAY_MODUS=                      # none needed (clock path 0 = external clock, present on the kit)
BSP_OVERLAY_MODUS_SHA256=

APP_TEMPLATE_REPO=https://github.com/Infineon/mtb-example-psoc-edge-hello-world.git
APP_TEMPLATE_COMMIT=a4a17e27cd7ca35630a6ede798a2adc3390b77b9

EXPECTED_DEVICE=PSE846GPS2DBZC4A        # verified 2026-10-03 (rev B0, VTarget 1.79 V)
EXPECTED_LIFECYCLE=DEVELOPMENT          # verified (acquire) 2026-10-03
OPENOCD_TARGET_CFG=target/infineon/pse84xgxs2.cfg   # EPC2 part

CONSOLE_BAUD=115200

POWER_CYCLE_AFTER_FLASH=0               # not needed for non-display apps; display firmware needs a replug
