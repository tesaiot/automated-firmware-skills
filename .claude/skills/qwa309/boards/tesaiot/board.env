# Board TYPE profile: TESAIoT PSoC Edge E84 DevKit = AI Kit (SoM) + QWA309 base board.
# Inherits everything from kit-pse84-ai (BSP, clocks, device, console); adds the QWA309 I/O.
# QWA309 I/O is not in the BSP: board/board.c configures it at run time when BOARD_TESAIOT
# is defined (BOARD_HAS_QWA309). HW reference: TESAIoT SDK docs J5.
# Status: AI-Kit part verified 2026-10-03; QWA309 SW5 (P17.5) verified 2026-10-10 - see README verification log.

BOARD_EXTENDS=kit-pse84-ai
BOARD_ID=tesaiot
BOARD_NAME="TESAIoT PSE84 DevKit"
BOARD_DEFINE=BOARD_TESAIOT
BOARD_PARTS="ai-kit qwa309"              # hardware groups: packs psoc-e84-ai-kit + qwa309 (pack.json / parts.json)
BOARD_COMPONENTS="qwa309-board"          # always applied for this board: qwa309.h, SW5/SW6 claims, switch settings
BTN_LABELS="SW1 (AI Kit user button),SW5 (QWA309 base board, P17.5),SW6 (QWA309 base board, P17.7)"   # BTN1..BTN3 = rev1 silkscreen (SDK names SW4/SW5)
# SW5/SW6 (P17.5/P17.7) = DVP camera RESET/PWDN nets: camera unplugged, or CAM ON/OFF = ON (frees SW5 only); CAM OFF clamps both low.
