{
  "spec": "pse84-ui/1",
  "name": "lvgl-demo",
  "display": {"width": 800, "height": 480},
  "theme": {"dark": true, "primary": "#2196F3", "secondary": "#F44336", "font": "montserrat_14"},
  "data": [
    {"id": "clicks", "init": 0, "min": 0, "max": 9999},
    {"id": "level", "init": 30, "min": 0, "max": 100, "source": "e.g. qwa309 pot 1 from CM33 (uiset level <v>)"},
    {"id": "led_on", "init": 0, "min": 0, "max": 1}
  ],
  "screens": [
    {
      "id": "main",
      "style": {"bg": "#101820"},
      "children": [
        {"id": "title", "type": "label", "text": "TESAIoT  LVGL 9.5  bare metal CM55",
         "align": "top_mid", "y": 16, "style": {"font": "montserrat_24", "text_color": "#FFFFFF"}},
        {"id": "left_col", "type": "container", "align": "left_mid", "x": 60, "y": -20, "w": 260, "h": "content",
         "style": {"bg_opa": 0, "border_width": 0, "pad": 0},
         "layout": {"flex": "column", "gap": 14, "cross": "center"},
         "children": [
           {"id": "press_btn", "type": "button", "text": "Press me", "w": 200, "h": 70,
            "on": {"clicked": {"inc": "clicks", "by": 1}}},
           {"id": "clicks_lbl", "type": "label", "bind": "clicks", "fmt": "Clicks: %d",
            "style": {"text_color": "#FFFFFF"}}
         ]},
        {"id": "right_col", "type": "container", "align": "right_mid", "x": -60, "y": -20, "w": 380, "h": "content",
         "style": {"bg_opa": 0, "border_width": 0, "pad": 10},
         "layout": {"flex": "column", "gap": 18, "cross": "center"},
         "children": [
           {"id": "level_slider", "type": "slider", "w": 340, "min": 0, "max": 100, "bind": "level"},
           {"id": "level_lbl", "type": "label", "bind": "level", "fmt": "Level: %d %%",
            "style": {"text_color": "#FFFFFF"}},
           {"id": "level_bar", "type": "bar", "w": 340, "h": 16, "min": 0, "max": 100, "bind": "level",
            "style": {"accent": "#4CAF50"}}
         ]},
        {"id": "settings_btn", "type": "button", "text": "Settings", "align": "bottom_right", "x": -20, "y": -20,
         "w": 140, "h": 50, "on": {"clicked": {"goto": "settings"}}},
        {"id": "hint_lbl", "type": "label", "text": "Designed in ui-designer, generated by ui_gen.py",
         "align": "bottom_left", "x": 20, "y": -34, "style": {"text_color": "#9AD0FF"}}
      ]
    },
    {
      "id": "settings",
      "style": {"bg": "#101820"},
      "children": [
        {"id": "settings_title", "type": "label", "text": "Settings", "align": "top_mid", "y": 16,
         "style": {"font": "montserrat_24", "text_color": "#FFFFFF"}},
        {"id": "settings_card", "type": "container", "align": "center", "w": 460, "h": "content",
         "layout": {"flex": "column", "gap": 20},
         "children": [
           {"id": "led_row", "type": "container", "w": "100%", "h": "content",
            "style": {"bg_opa": 0, "border_width": 0, "pad": 0},
            "layout": {"flex": "row", "main": "space_between", "cross": "center"},
            "children": [
              {"id": "led_lbl", "type": "label", "text": "LED on CM33"},
              {"id": "led_sw", "type": "switch", "bind": "led_on", "on": {"value_changed": "user"}}
            ]},
           {"id": "mode_dd", "type": "dropdown", "w": "100%", "options": ["Normal", "Eco", "Boost"]},
           {"id": "reset_btn", "type": "button", "text": "Reset counter", "w": "100%", "h": 50,
            "on": {"clicked": [{"set": "clicks", "value": 0}, "user"]}}
         ]},
        {"id": "back_btn", "type": "button", "text": "Back", "align": "bottom_left", "x": 20, "y": -20,
         "w": 120, "h": 50, "on": {"clicked": {"goto": "main"}}}
      ]
    }
  ]
}
